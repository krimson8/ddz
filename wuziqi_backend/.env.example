# wuziqi_backend environment variables
# Copy this file to .env and fill in the values for local development.
# On Railway, set these in the service's Variables tab.

# Port the server listens on.
# Railway injects PORT automatically — do not set it manually on Railway.
# Local default is 4897 (the DDZ backend uses 4896, so both can run together).
PORT=4897

# Allowed CORS origin for both HTTP and WebSocket connections.
# Local default is http://localhost:3001 (the wuziqi frontend's dev port).
# On Railway set this to the deployed Vercel frontend URL, e.g.:
#   CORS_ORIGIN=https://your-wuziqi-frontend.vercel.app
CORS_ORIGIN=http://localhost:3001

# Postgres connection. SHARED with DDZ — point at the SAME database.
# Local: the Railway Postgres PUBLIC url. On Railway: reference the existing
# Postgres addon with ${{Postgres.DATABASE_URL}} (do NOT provision a second DB).
DATABASE_URL=

# Firebase Admin service-account JSON (one line). SAME Firebase project as DDZ.
# Local dev can instead place firebase-admin.json in this folder (git-ignored);
# the app reads FIREBASE_ADMIN_KEY first, then falls back to the file.
# FIREBASE_ADMIN_KEY=
