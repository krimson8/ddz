# Backend environment variables
# Copy this file to .env and fill in the values for local development.
# On Railway, set these in the service's Variables tab.

# Port the server listens on.
# Railway injects this automatically — do not set manually on Railway.
PORT=4896

# Allowed CORS origin for both HTTP and WebSocket connections.
# Set this to your deployed Vercel frontend URL, e.g.:
# CORS_ORIGIN=https://your-app.vercel.app
# For local development the default is http://localhost:3000
CORS_ORIGIN=http://localhost:3000
